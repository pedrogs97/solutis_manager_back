meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/auth/login/
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  username: {{USERNAME}}
  password: {{PASSWORD}}
}

script:post-response {
  const jsonData = res.getBody();

  if (jsonData.access_token) {
      bru.setEnvVar("TOKEN", `Bearer ${jsonData.access_token}`);
  }

}

settings {
  encodeUrl: true
}

docs {
  Gets information about the authenticated user.
}
